{
  "name": "native-legal-v2",
  "user": "ubuntu",
  "install": "cd /agent/repos/native-legal-v2 && npm ci",
  "start": "bash /agent/repos/native-legal-v2/.cursor/start.sh",
  "terminals": [
    {
      "name": "dev",
      "command": "cd /agent/repos/native-legal-v2 && DATABASE_URL=postgresql://postgres:postgres@localhost:5432/native_legal npm run dev"
    }
  ],
  "ports": [
    {
      "name": "app",
      "port": 5000
    }
  ]
}
